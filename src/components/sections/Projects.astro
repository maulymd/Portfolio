---
import { projects } from "../../data/projects";
import Card from "../ui/Card.astro";
import SectionTitle from "../ui/SectionTitle.astro";
import SkillTag from "../ui/SkillTag.astro";
---

<section id="projects">
  <div class="container">
    <SectionTitle
      i18nKey="projects.title"
      defaultText="Proyek & Pengujian Unggulan"
    />

    <!-- Project Filter Buttons -->
    <div class="project-filter-bar">
      <button class="project-filter-btn active" data-filter="all">
        <i class="fas fa-layer-group"></i> Semua Proyek ({projects.length})
      </button>
      <button class="project-filter-btn" data-filter="automation">
        <i class="fas fa-robot"></i> Automation (E2E)
      </button>
      <button class="project-filter-btn" data-filter="api">
        <i class="fas fa-network-wired"></i> API Testing
      </button>
      <button class="project-filter-btn" data-filter="mobile">
        <i class="fas fa-mobile-alt"></i> Mobile QA
      </button>
      <button class="project-filter-btn" data-filter="web">
        <i class="fas fa-laptop-code"></i> Web QA
      </button>
      <button class="project-filter-btn" data-filter="manual">
        <i class="fas fa-clipboard-check"></i> Manual & UAT
      </button>
    </div>

    <div class="grid" id="projectsGrid">
      {
        projects.map((proj) => (
          <div class="project-item" data-category={proj.category || "all"}>
            <Card featured={proj.featured} class="project-card-custom">
              {proj.image && (
                <div class="card-thumb-wrap">
                  <img
                    src={proj.image}
                    alt={proj.title}
                    class="card-thumb-img"
                    loading="lazy"
                    onerror="this.onerror=null; this.closest('.card-thumb-wrap').style.display='none';"
                  />
                  <span class="role-pill">
                    <i class="fas fa-user-shield" /> {proj.role}
                  </span>
                </div>
              )}

              <div class="project-card-body">
                <div class="project-meta-row">
                  <span class="project-date">
                    <i class="far fa-calendar-alt" /> {proj.date}
                  </span>
                  {!proj.image && (
                    <span class="role-pill-inline">
                      <i class="fas fa-user-shield" /> {proj.role}
                    </span>
                  )}
                </div>

                <h3 class="project-card-title">
                  <a href={`/projects/${proj.id}`} class="title-link">
                    {proj.title}
                  </a>
                </h3>

                <p class="project-card-desc">{proj.description}</p>

                {proj.techStack && proj.techStack.length > 0 && (
                  <div
                    class="skills-wrapper"
                    style="margin-top: 14px; margin-bottom: 20px;"
                  >
                    {proj.techStack.slice(0, 4).map((tech) => (
                      <SkillTag name={tech.name} />
                    ))}
                    {proj.techStack.length > 4 && (
                      <span class="more-stack-pill">
                        +{proj.techStack.length - 4}
                      </span>
                    )}
                  </div>
                )}

                <div class="project-card-action">
                  <a href={`/projects/${proj.id}`} class="view-detail-btn">
                    <span>Lihat Detail & Studi Kasus</span>
                    <i class="fas fa-arrow-right" />
                  </a>
                </div>
              </div>
            </Card>
          </div>
        ))
      }
    </div>
  </div>
</section>

<style>
  .project-filter-bar {
    display: flex;
    gap: 10px;
    flex-wrap: wrap;
    margin-bottom: 32px;
  }

  .project-filter-btn {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 8px 18px;
    border-radius: 30px;
    border: 1px solid var(--border);
    background: var(--card-bg);
    color: var(--text-secondary);
    font-size: 0.85rem;
    font-weight: 600;
    cursor: pointer;
    font-family: inherit;
    transition: all 0.25s ease;
  }

  .project-filter-btn i {
    font-size: 0.8rem;
    color: var(--text-muted);
    transition: color 0.2s;
  }

  .project-filter-btn:hover {
    border-color: var(--accent);
    color: var(--accent);
    transform: translateY(-2px);
  }

  .project-filter-btn.active {
    background: var(--accent);
    color: #ffffff;
    border-color: var(--accent);
    box-shadow: 0 4px 14px var(--accent-glow);
  }

  .project-filter-btn.active i {
    color: #ffffff;
  }

  .project-item {
    transition: all 0.35s ease;
    display: flex;
  }

  .project-item :global(.card) {
    display: flex;
    flex-direction: column;
    padding: 0;
    overflow: hidden;
    height: 100%;
    width: 100%;
  }

  .card-thumb-wrap {
    position: relative;
    width: 100%;
    aspect-ratio: 16 / 9;
    background: var(--bg-tertiary);
    overflow: hidden;
  }

  .card-thumb-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.4s ease;
  }

  .project-item :global(.card):hover .card-thumb-img {
    transform: scale(1.05);
  }

  .role-pill {
    position: absolute;
    bottom: 12px;
    left: 12px;
    background: rgba(15, 23, 42, 0.85);
    backdrop-filter: blur(6px);
    color: #ffffff;
    font-size: 0.75rem;
    font-weight: 700;
    padding: 4px 10px;
    border-radius: 14px;
    border: 1px solid rgba(255, 255, 255, 0.2);
    display: inline-flex;
    align-items: center;
    gap: 6px;
  }

  .role-pill i {
    color: var(--accent-light);
  }

  .project-card-body {
    padding: 22px;
    display: flex;
    flex-direction: column;
    flex-grow: 1;
  }

  .project-meta-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 10px;
  }

  .project-date {
    font-size: 0.8rem;
    color: var(--accent);
    font-weight: 600;
    display: inline-flex;
    align-items: center;
    gap: 6px;
  }

  .role-pill-inline {
    font-size: 0.75rem;
    padding: 2px 8px;
    background: var(--tag-bg);
    color: var(--tag-text);
    border-radius: 10px;
    font-weight: 600;
  }

  .project-card-title {
    font-size: 1.25rem;
    font-weight: 700;
    margin-bottom: 10px;
    line-height: 1.35;
  }

  .title-link {
    color: var(--text-primary);
    text-decoration: none;
    transition: color 0.2s ease;
  }

  .title-link:hover {
    color: var(--accent);
  }

  .project-card-desc {
    color: var(--text-secondary);
    font-size: 0.92rem;
    line-height: 1.6;
    flex-grow: 1;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .more-stack-pill {
    display: inline-flex;
    align-items: center;
    padding: 3px 8px;
    border-radius: 12px;
    background: var(--bg-tertiary);
    color: var(--text-muted);
    font-size: 0.72rem;
    font-weight: 700;
  }

  .project-card-action {
    margin-top: auto;
    padding-top: 14px;
    border-top: 1px solid var(--border);
  }

  .view-detail-btn {
    display: inline-flex;
    align-items: center;
    justify-content: space-between;
    width: 100%;
    color: var(--accent);
    text-decoration: none;
    font-size: 0.88rem;
    font-weight: 700;
    padding: 6px 0;
    transition: all 0.2s ease;
  }

  .view-detail-btn i {
    transition: transform 0.2s ease;
  }

  .view-detail-btn:hover {
    color: var(--accent-light);
  }

  .view-detail-btn:hover i {
    transform: translateX(5px);
  }

  .project-item.hidden {
    display: none;
  }

  @keyframes cardFadeIn {
    from {
      opacity: 0;
      transform: translateY(12px) scale(0.98);
    }
    to {
      opacity: 1;
      transform: translateY(0) scale(1);
    }
  }

  .project-item.animate-in {
    animation: cardFadeIn 0.35s ease forwards;
  }
</style>

<script>
  const filterBtns = document.querySelectorAll(".project-filter-btn");
  const projectItems = document.querySelectorAll(".project-item");

  filterBtns.forEach((btn) => {
    btn.addEventListener("click", () => {
      filterBtns.forEach((b) => b.classList.remove("active"));
      btn.classList.add("active");

      const filter = btn.getAttribute("data-filter");

      projectItems.forEach((item) => {
        const cat = item.getAttribute("data-category");
        if (filter === "all" || cat === filter) {
          item.classList.remove("hidden");
          item.classList.remove("animate-in");
          // Trigger reflow for smooth animation restart
          void (item as HTMLElement).offsetWidth;
          item.classList.add("animate-in");
        } else {
          item.classList.add("hidden");
        }
      });
    });
  });
</script>
