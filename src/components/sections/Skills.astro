---
import skills from "../../data/skills.json";
import SectionTitle from "../ui/SectionTitle.astro";
---

<section id="skills">
  <div class="container">
    <SectionTitle i18nKey="skills.title" defaultText="Keahlian & Tools" />
    <div class="skills-grid">
      {skills.map((pillar) => (
        <div class="skill-pillar-card">
          <div class="pillar-header">
            <div class="pillar-icon-box">
              <i class={pillar.icon}></i>
            </div>
            <div>
              <h3 class="pillar-title" data-i18n={pillar.titleKey}>{pillar.titleKey}</h3>
            </div>
          </div>
          <p class="pillar-desc" data-i18n={pillar.descKey}>{pillar.descKey}</p>
          <div class="pillar-tags">
            {pillar.skills.map((item) => (
              <span class="skill-pill">
                <i class="fas fa-check-circle"></i>
                {item}
              </span>
            ))}
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .skills-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
    gap: 28px;
    margin-top: 10px;
  }

  .skill-pillar-card {
    background: var(--card-bg);
    border: 1px solid var(--border);
    border-radius: 16px;
    padding: 30px 26px;
    display: flex;
    flex-direction: column;
    gap: 16px;
    box-shadow: var(--shadow);
    transition: transform 0.3s ease, border-color 0.3s ease, box-shadow 0.3s ease;
    position: relative;
    overflow: hidden;
  }

  .skill-pillar-card:hover {
    transform: translateY(-5px);
    border-color: var(--accent);
    box-shadow: var(--shadow-lg), 0 0 20px var(--accent-glow);
  }

  .pillar-header {
    display: flex;
    align-items: center;
    gap: 16px;
  }

  .pillar-icon-box {
    width: 48px;
    height: 48px;
    border-radius: 12px;
    background: var(--tag-bg);
    color: var(--accent);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1.35rem;
    flex-shrink: 0;
    transition: background-color 0.3s, color 0.3s;
  }

  .skill-pillar-card:hover .pillar-icon-box {
    background: var(--accent);
    color: #ffffff;
  }

  .pillar-title {
    font-size: 1.2rem;
    font-weight: 700;
    color: var(--text-primary);
    margin: 0;
  }

  .pillar-desc {
    font-size: 0.92rem;
    color: var(--text-muted);
    line-height: 1.6;
    margin: 0;
  }

  .pillar-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-top: 6px;
  }

  .skill-pill {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    background: var(--tag-bg);
    color: var(--tag-text);
    padding: 6px 13px;
    border-radius: 20px;
    font-size: 0.82rem;
    font-weight: 500;
    border: 1px solid transparent;
    transition: all 0.2s ease;
  }

  .skill-pill i {
    font-size: 0.75rem;
    color: var(--accent);
  }

  .skill-pillar-card:hover .skill-pill {
    border-color: rgba(16, 185, 129, 0.25);
  }

  .skill-pill:hover {
    transform: translateY(-2px);
    background: var(--accent);
    color: #ffffff;
  }

  .skill-pill:hover i {
    color: #ffffff;
  }
</style>
