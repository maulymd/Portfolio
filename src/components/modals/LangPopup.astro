<div id="langPopup" class="lang-popup-overlay">
  <div class="lang-popup-container">
    <h2>🌐 Pilih Bahasa</h2>
    <p id="popupSubtext">Pilih bahasa yang Anda inginkan / Choose your preferred language</p>
    <div class="lang-buttons">
      <button class="lang-btn-popup lang-btn-primary" type="button" onclick="setLanguage('id')">
        🇮🇩 Bahasa Indonesia
      </button>
      <button class="lang-btn-popup lang-btn-secondary" type="button" onclick="setLanguage('en')">
        🇬🇧 English
      </button>
    </div>
  </div>
</div>
